# Copie para .env e ajuste. Nunca suba o .env para o GitHub.
NODE_ENV=development
PORT=3333

# Banco: sqlite (padrão, zero configuração) ou pg (PostgreSQL)
DB_CLIENT=sqlite
SQLITE_FILE=./data/safecash.db
# DATABASE_URL=postgres://usuario:senha@localhost:5432/safecash
# DATABASE_SSL=false

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Tentativas de login por IP a cada 15 min
LOGIN_RATE_LIMIT=10

# true = popula dados de demonstração na primeira subida (só se o banco estiver vazio)
SEED_ON_START=false
